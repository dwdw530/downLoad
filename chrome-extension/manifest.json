{
  "manifest_version": 3,
  "name": "daw视频下载助手",
  "version": "0.2.0",
  "description": "识别网页视频，将 MP4、WebM 视频发送到daw下载器。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["storage", "webRequest", "webNavigation", "nativeMessaging", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "daw视频下载助手"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "web_accessible_resources": [{"resources": ["icons/download.svg"], "matches": ["http://*/*", "https://*/*"]}]
}
